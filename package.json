{
  "name": "PeachCourt",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "npm run test.unit && npm run test.functions && npm run test.rules && npm run test.e2e",
    "test.unit": "vitest run",
    "test.functions": "npm --prefix functions test",
    "test.rules": "firebase emulators:exec --only firestore --project demo-peachcourt \"vitest run --config vitest.rules.config.ts\"",
    "test.e2e": "firebase emulators:exec --only auth,firestore --project demo-peachcourt \"playwright test\"",
    "lint": "eslint",
    "export": "node scripts/exportEvents.mjs",
    "build.functions": "npm --prefix functions run build",
    "deploy.functions": "firebase deploy --only functions"
  },
  "dependencies": {
    "@capacitor/core": "8.5.3",
    "@capacitor/geolocation": "^8.2.4",
    "@ionic/react": "^9.0.0",
    "@ionic/react-router": "^9.0.0",
    "firebase": "^13.1.0",
    "ionicons": "^8.1.0",
    "leaflet": "^1.9.4",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-leaflet": "^5.0.0",
    "react-router": "^6.30.0",
    "react-router-dom": "^6.30.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "1.56.1",
    "@types/leaflet": "^1.9.22",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "@vitejs/plugin-legacy": "^8.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "eslint": "^9.20.1",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "^15.34.1",
    "globals": "^15.15.0",
    "terser": "^5.16.0",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.24.0",
    "vite": "8.3.4",
    "vitest": "~4.0.18"
  },
  "description": "An Ionic project"
}