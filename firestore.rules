rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function signedInAs(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function validSkill(sport, skill) {
      return skill == 'any'
        || (sport == 'tennis' && skill in [1.5, 2, 2.5, 3, 3.5, 4, 4.5, 5, 5.5, 6, 6.5, 7])
        || (sport == 'pickleball' && skill in [2, 2.5, 3, 3.5, 4, 4.5, 5]);
    }

    function isCheckinVariant(value) {
      return value in ['auto_on', 'auto_off'];
    }

    function isTeamMember() {
      return request.auth != null
        && exists(/databases/$(database)/documents/config/teamAccounts)
        && request.auth.uid in get(/databases/$(database)/documents/config/teamAccounts).data.uids;
    }

    match /courts/{courtId} {
      allow read: if true;
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if signedInAs(uid);
      allow create: if signedInAs(uid)
        && (
          !('checkinVariant' in request.resource.data)
          || isCheckinVariant(request.resource.data.checkinVariant)
        );
      allow update: if signedInAs(uid)
        && (
          request.resource.data.get('checkinVariant', null)
            == resource.data.get('checkinVariant', null)
          || (
            resource.data.get('checkinVariant', null) == null
            && isCheckinVariant(request.resource.data.get('checkinVariant', null))
          )
        );
      allow delete: if false;

      match /fcmTokens/{token} {
        allow read, delete: if signedInAs(uid);
        allow create: if signedInAs(uid)
          && request.resource.data.keys().hasOnly(['token', 'createdAt'])
          && request.resource.data.token is string
          && request.resource.data.token.size() > 0
          && request.resource.data.createdAt is timestamp;
        allow update: if false;
      }
    }

    match /checkins/{checkinId} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.courtId is string
        && request.resource.data.playerCount is int
        && request.resource.data.playerCount in [1, 2, 5, 9, 16]
        && request.resource.data.checkedInAt is timestamp
        && request.resource.data.scheduledArrivalAt is timestamp
        && request.resource.data.durationMinutes in [30, 60]
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.active == true
        && (
          request.resource.data.distance is number
          || request.resource.data.distance == null
        )
        && request.resource.data.timeToCheckIn is number;

      allow read: if signedIn()
        && (resource.data.active == true || resource.data.uid == request.auth.uid);

      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['active', 'checkedOutAt'])
        && request.resource.data.active == false
        && request.resource.data.checkedOutAt is timestamp;

      allow delete: if false;
    }

    match /activeCheckins/{uid} {
      allow read: if signedInAs(uid);
      allow create, update: if signedInAs(uid)
        && request.resource.data.uid == uid
        && request.resource.data.checkinId is string
        && request.resource.data.courtId is string
        && request.resource.data.playerCount is int
        && request.resource.data.playerCount in [1, 2, 5, 9, 16]
        && request.resource.data.checkedInAt is timestamp
        && request.resource.data.scheduledArrivalAt is timestamp
        && request.resource.data.durationMinutes in [30, 60]
        && request.resource.data.expiresAt is timestamp;
      allow delete: if signedInAs(uid);
    }

    match /courtStatus/{courtId} {
      allow read: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['playerCount', 'reportedBy', 'reportedAt'])
        && request.resource.data.reportedBy == request.auth.uid
        && request.resource.data.playerCount is int
        && request.resource.data.playerCount in [1, 2, 5, 9, 16]
        && request.resource.data.reportedAt == request.time
        && getAfter(/databases/$(database)/documents/activeCheckins/$(request.auth.uid)).data.courtId == courtId;
      allow delete: if false;
    }

    match /matches/{matchId} {
      allow read: if signedIn();

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'courtId', 'courtName', 'sport', 'hostUid', 'hostName', 'format', 'startAt', 'skillLevel',
          'spotsTotal', 'playerUids', 'playerNames', 'removedUids', 'status', 'createdAt'
        ])
        && request.resource.data.hostUid == request.auth.uid
        && request.resource.data.courtId is string
        && request.resource.data.courtName is string
        && request.resource.data.hostName is string
        && request.resource.data.hostName.size() > 0
        && request.resource.data.hostName.size() <= 40
        && (
          (request.resource.data.format == 'singles' && request.resource.data.spotsTotal == 1)
          || (request.resource.data.format == 'doubles' && request.resource.data.spotsTotal == 3)
        )
        && request.resource.data.sport in ['tennis', 'pickleball']
        && validSkill(request.resource.data.sport, request.resource.data.skillLevel)
        && request.resource.data.startAt is timestamp
        && request.resource.data.startAt > request.time
        && request.resource.data.playerUids.size() == 0
        && request.resource.data.playerNames.size() == 0
        && (
          !('removedUids' in request.resource.data)
          || request.resource.data.removedUids.size() == 0
        )
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt is timestamp;

      allow update: if signedIn()
        && resource.data.startAt > request.time
        && (
          (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['playerUids', 'playerNames', 'status'])
            && request.resource.data.playerNames.size() == request.resource.data.playerUids.size()
            && (
              (
                resource.data.hostUid != request.auth.uid
                && !(request.auth.uid in resource.data.playerUids)
                && !(request.auth.uid in resource.data.get('removedUids', []))
                && resource.data.playerUids.size() < resource.data.spotsTotal
                && request.resource.data.playerUids == resource.data.playerUids.concat([request.auth.uid])
                && request.resource.data.playerNames[request.resource.data.playerNames.size() - 1] is string
                && request.resource.data.playerNames[request.resource.data.playerNames.size() - 1].size() > 0
                && request.resource.data.playerNames[request.resource.data.playerNames.size() - 1].size() <= 40
                && (
                  (request.resource.data.playerUids.size() == resource.data.spotsTotal
                    && request.resource.data.status == 'full')
                  || (request.resource.data.playerUids.size() < resource.data.spotsTotal
                    && request.resource.data.status == 'open')
                )
              )
              || (
                request.auth.uid in resource.data.playerUids
                && request.resource.data.playerUids == resource.data.playerUids.removeAll([request.auth.uid])
                && request.resource.data.status == 'open'
              )
            )
          )
          || (
            resource.data.hostUid == request.auth.uid
            && resource.data.playerUids.size() > 0
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['hostUid', 'hostName', 'playerUids', 'playerNames', 'status'])
            && request.resource.data.hostUid == resource.data.playerUids[0]
            && request.resource.data.hostName == resource.data.playerNames[0]
            && request.resource.data.playerUids.size() == resource.data.playerUids.size() - 1
            && request.resource.data.playerNames.size() == resource.data.playerNames.size() - 1
            && request.resource.data.status == 'open'
          )
          || (
            resource.data.hostUid == request.auth.uid
            && resource.data.playerUids.size() > 0
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['playerUids', 'playerNames', 'removedUids', 'status'])
            && request.resource.data.playerUids.size() == resource.data.playerUids.size() - 1
            && request.resource.data.playerNames.size() == resource.data.playerNames.size() - 1
            && request.resource.data.removedUids.size() == resource.data.get('removedUids', []).size() + 1
            && request.resource.data.status == 'open'
          )
        );

      allow delete: if signedIn()
        && resource.data.hostUid == request.auth.uid;
    }

    match /chats/{matchId} {
      allow read: if signedIn()
        && request.auth.uid in resource.data.playerUids;
      allow create, delete: if false;
      allow update: if signedIn()
        && request.auth.uid in resource.data.playerUids
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['readAt'])
        && request.resource.data.readAt.diff(resource.data.readAt).affectedKeys()
          .hasOnly([request.auth.uid]);

      match /messages/{msgId} {
        allow read: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(matchId)).data.playerUids;
        allow create: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/chats/$(matchId)).data.playerUids
          && request.resource.data.keys().hasOnly(['text', 'senderUid', 'senderName', 'createdAt'])
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
          && request.resource.data.senderName is string
          && request.resource.data.senderName.size() > 0
          && request.resource.data.createdAt is timestamp;
        allow update, delete: if false;
      }
    }

    match /alerts/{alertId} {
      allow read: if signedIn() && resource.data.recipientUid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.recipientUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read == true;
      allow create, delete: if false;
    }

    match /config/teamAccounts {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /config/flags {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /inPersonCounts/{countId} {
      allow read: if isTeamMember();
      allow create: if isTeamMember()
        && request.resource.data.keys().hasOnly(['courtId', 'uid', 'playerCount', 'recordedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.courtId is string
        && request.resource.data.playerCount is int
        && request.resource.data.playerCount in [1, 2, 5, 9, 16]
        && request.resource.data.recordedAt is timestamp;
      allow update, delete: if false;
    }

    match /events/{eventId} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.timestamp is timestamp
        && (
          (
            request.resource.data.eventName == 'check_in'
            && request.resource.data.courtId is string
            && request.resource.data.playerCount is int
            && request.resource.data.scheduledArrivalAt is timestamp
            && request.resource.data.durationMinutes in [30, 60]
            && request.resource.data.timeToCheckIn is number
            && (
              request.resource.data.distance is number
              || request.resource.data.distance == null
            )
          )
          || (
            request.resource.data.eventName == 'check_out'
            && request.resource.data.courtId is string
            && request.resource.data.timeToCheckIn is number
            && (
              request.resource.data.distance is number
              || request.resource.data.distance == null
            )
          )
          || (
            request.resource.data.eventName == 'checkin_feedback'
            && request.resource.data.answer in [
              'forgot',
              'too_much_effort',
              'privacy',
              'nobody_else_uses_it'
            ]
          )
          || (
            request.resource.data.eventName == 'match_posted'
            && request.resource.data.courtId is string
            && request.resource.data.matchId is string
            && request.resource.data.sport in ['tennis', 'pickleball']
            && request.resource.data.format in ['singles', 'doubles']
            && validSkill(request.resource.data.sport, request.resource.data.skillLevel)
            && request.resource.data.spotsTotal in [1, 3]
          )
          || (
            request.resource.data.eventName == 'match_joined'
            && request.resource.data.courtId is string
            && request.resource.data.matchId is string
            && request.resource.data.minutesToJoin is int
            && request.resource.data.joinSource is string
            && request.resource.data.homeScreen is bool
          )
          || (
            request.resource.data.eventName == 'notification_opened'
            && request.resource.data.source == 'push'
            && request.resource.data.courtId is string
          )
          || (
            request.resource.data.eventName == 'trust_rating'
            && request.resource.data.courtId is string
            && request.resource.data.rating in [1, 2, 3, 4, 5]
            && request.resource.data.liveCount is int
          )
          || (
            request.resource.data.eventName == 'trust_skipped'
            && request.resource.data.courtId is string
            && request.resource.data.liveCount is int
          )
          || (
            request.resource.data.eventName == 'court_viewed'
            && request.resource.data.courtId is string
            && (
              request.resource.data.reportedCount is int
              || request.resource.data.reportedCount == null
            )
          )
          || request.resource.data.eventName == 'feedback_skipped'
          || (
            request.resource.data.eventName == 'count_updated'
            && request.resource.data.courtId is string
            && request.resource.data.playerCount is int
          )
          || (
            request.resource.data.eventName == 'still_here_yes'
            && request.resource.data.courtId is string
            && request.resource.data.playerCount is int
          )
          || (
            request.resource.data.eventName == 'still_here_skipped'
            && request.resource.data.courtId is string
          )
          || (
            request.resource.data.eventName == 'auto_checkin_changed'
            && request.resource.data.wasOn is bool
            && request.resource.data.isOn is bool
            && request.resource.data.wasOn != request.resource.data.isOn
            && request.resource.data.source in ['onboarding', 'settings']
            && request.resource.data.cause in ['user', 'location_off']
            && (
              request.resource.data.variant == null
              || isCheckinVariant(request.resource.data.variant)
            )
          )
          || (
            request.resource.data.eventName == 'confirm_yes'
            && request.resource.data.courtId is string
          )
          || (
            request.resource.data.eventName == 'confirm_no'
            && request.resource.data.courtId is string
          )
          || (
            request.resource.data.eventName == 'permission_location'
            && request.resource.data.granted is bool
          )
          || (
            request.resource.data.eventName == 'permission_notifications'
            && request.resource.data.granted is bool
          )
          || (
            request.resource.data.eventName == 'game_left'
            && request.resource.data.matchId is string
            && request.resource.data.courtId is string
          )
          || (
            request.resource.data.eventName == 'game_deleted'
            && request.resource.data.matchId is string
            && request.resource.data.courtId is string
          )
          || (
            request.resource.data.eventName == 'host_changed'
            && request.resource.data.matchId is string
            && request.resource.data.courtId is string
          )
          || (
            request.resource.data.eventName == 'player_removed'
            && request.resource.data.matchId is string
            && request.resource.data.courtId is string
          )
          || (
            isTeamMember()
            && request.resource.data.eventName == 'in_person_count'
            && request.resource.data.courtId is string
            && request.resource.data.playerCount is int
            && (
              request.resource.data.appPlayerCount is int
              || request.resource.data.appPlayerCount == null
            )
          )
        );
      allow read, update, delete: if false;
    }
  }
}